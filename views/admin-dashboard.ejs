<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Basic Page Needs -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    <title>Georgeforwarders - Admin Dashboard</title>
    <meta name="author" content="trivlogic.com">

    <!-- Theme Style -->
    <link rel="stylesheet" type="text/css" href="/admin-css/animate.min.css">
    <link rel="stylesheet" type="text/css" href="/admin-css/animation.css">
    <link rel="stylesheet" type="text/css" href="/admin-css/bootstrap.css">
    <link rel="stylesheet" type="text/css" href="/admin-css/bootstrap-select.min.css">
    <link rel="stylesheet" type="text/css" href="/admin-css/styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">

    <!-- Font -->
    <link rel="stylesheet" href="/admin-font/fonts.css">

    <!-- Icon -->
    <link rel="stylesheet" href="/admin-icon/style.css">

    <!-- Favicon and Touch Icons  -->
    <link rel="shortcut icon" href="/images/george/logo.png">
    <link rel="apple-touch-icon-precomposed" href="/images/george/logo.png">

    <!-- Custom Styles -->
    <style>
        .stat-card {
            background: #fff;
            border-radius: 12px;
            padding: 24px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
            transition: all 0.3s ease;
            margin-bottom: 24px;
        }
        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 4px 16px rgba(0,0,0,0.12);
        }
        .stat-icon {
            width: 60px;
            height: 60px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 16px;
        }
        .stat-icon.blog {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }
        .stat-icon.testimonial {
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        }
        .stat-icon svg {
            width: 32px;
            height: 32px;
        }
        .stat-value {
            font-size: 36px;
            font-weight: 700;
            color: #2d3748;
            margin-bottom: 4px;
        }
        .stat-label {
            font-size: 14px;
            color: #718096;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .recent-item {
            padding: 16px;
            border-bottom: 1px solid #e2e8f0;
            transition: background 0.2s ease;
        }
        .recent-item:last-child {
            border-bottom: none;
        }
        .recent-item:hover {
            background: #f7fafc;
        }
        .recent-item img {
            width: 48px;
            height: 48px;
            border-radius: 8px;
            object-fit: cover;
        }
        .recent-title {
            font-weight: 600;
            color: #2d3748;
            margin-bottom: 4px;
        }
        .recent-date {
            font-size: 12px;
            color: #718096;
        }
        .quick-action {
            display: flex;
            align-items: center;
            padding: 16px;
            border-radius: 8px;
            background: #f7fafc;
            transition: all 0.2s ease;
            text-decoration: none;
            color: #2d3748;
        }
        .quick-action:hover {
            background: #edf2f7;
            transform: translateX(4px);
        }
        .quick-action-icon {
            width: 40px;
            height: 40px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 12px;
            color: #fff;
        }
        .quick-action-text {
            font-weight: 600;
        }
        @media (max-width: 768px) {
            .stat-card {
                margin-bottom: 16px;
            }
            .stat-value {
                font-size: 28px;
            }
        }
        
        /* New styles for content overview */
        .content-stats {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 24px;
            margin-bottom: 30px;
        }
        
        .insight-card {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 16px;
            padding: 20px;
            color: white;
        }
        
        .insight-card.testimonial-card {
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        }
        
        .insight-stats {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
        }
        
        .insight-number {
            font-size: 42px;
            font-weight: 700;
        }
        
        .engagement-metrics {
            background: #f8f9fa;
            border-radius: 12px;
            padding: 20px;
            margin-top: 20px;
        }
        
        .metric-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0;
            border-bottom: 1px solid #e2e8f0;
        }
        
        .metric-item:last-child {
            border-bottom: none;
        }
        
        .rating-stars {
            color: #fbbf24;
        }
        
        .status-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 500;
        }
        
        .status-published {
            background: #c6f6d5;
            color: #22543d;
        }
        
        .status-draft {
            background: #fed7d7;
            color: #742a2a;
        }
    </style>
</head>

<body>

    <!-- #wrapper -->
    <div id="wrapper">
        <!-- #page -->
        <div id="page" class="">
            <!-- layout-wrap -->
            <div class="layout-wrap">
                <!-- preload -->
                <div id="preload" class="preload-container">
                    <div class="preloading">
                        <span></span>
                    </div>
                </div>
                <!-- /preload -->
                <!-- section-menu-left (unchanged) -->
                <div class="section-menu-left">
                    <div class="box-logo">
                        <a href="/admin/admin-dashboard" id="site-logo-inner">
                            <img style="width:60px;" id="logo_header" alt="" src="/images/george/logo.png" data-light="/images/george/logo.png" data-dark="img/logo.png" >
                        </a>
                        <div class="button-show-hide">
                            <i class="icon-chevron-left"></i>
                        </div>
                    </div>
                    <div class="section-menu-left-wrap">
                        <div class="center">
                            <div class="center-item">
                                <ul class="">
                                    <li class="menu-item active">
                                        <a href="/admin/admin-dashboard" class="">
                                            <div class="icon">
                                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                    <path fill-rule="evenodd" clip-rule="evenodd" d="M12.2652 3.57566C12.1187 3.42921 11.8813 3.42921 11.7348 3.57566L5.25 10.0605V19.8748C5.25 20.0819 5.41789 20.2498 5.625 20.2498H9V16.1248C9 15.0893 9.83947 14.2498 10.875 14.2498H13.125C14.1605 14.2498 15 15.0893 15 16.1248V20.2498H18.375C18.5821 20.2498 18.75 20.0819 18.75 19.8748V10.0605L12.2652 3.57566ZM20.25 11.5605L21.2197 12.5302C21.5126 12.8231 21.9874 12.8231 22.2803 12.5302C22.5732 12.2373 22.5732 11.7624 22.2803 11.4695L13.3258 2.51499C12.5936 1.78276 11.4064 1.78276 10.6742 2.515L1.71967 11.4695C1.42678 11.7624 1.42678 12.2373 1.71967 12.5302C2.01256 12.8231 2.48744 12.8231 2.78033 12.5302L3.75 11.5605V19.8748C3.75 20.9104 4.58947 21.7498 5.625 21.7498H18.375C19.4105 21.7498 20.25 20.9104 20.25 19.8748V11.5605ZM13.5 20.2498H10.5V16.1248C10.5 15.9177 10.6679 15.7498 10.875 15.7498H13.125C13.3321 15.7498 13.5 15.9177 13.5 16.1248V20.2498Z" fill="#111111"/>
                                                </svg>
                                            </div>
                                            <div class="text">Admin Dashboard</div>
                                        </a>
                                    </li>
                                    <li class="menu-item ">
                                        <a href="/admin/admin-blogs" class="menu-item-button">
                                            <div class="icon"><i class="icon-file-plus"></i></div>
                                            <div class="text">Blog Management</div>
                                        </a>
                                    </li>
                                    <li class="menu-item ">
                                        <a href="/admin/admin-services" class="menu-item-button">
                                            <div class="icon"><i class="fa fa-briefcase"></i></div>
                                            <div class="text">Service Management</div>
                                        </a>
                                    </li>
                                    <li class="menu-item ">
                                        <a href="/admin/admin-testimonials" class="menu-item-button">
                                            <div class="icon"><i class="fa fa-users"></i></div>
                                            <div class="text">Testimonials Management</div>
                                        </a>
                                    </li>
                                    <li class="menu-item">
                                        <a href="/admin/logout" class="">
                                            <div class="icon">
                                                <svg width="24" height="22" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                    <path d="M8.125 18.6875C8.125 18.903 8.0394 19.1097 7.88702 19.262C7.73465 19.4144 7.52799 19.5 7.3125 19.5H1.625C1.19402 19.5 0.780698 19.3288 0.475951 19.024C0.171205 18.7193 0 18.306 0 17.875V1.625C0 1.19402 0.171205 0.780698 0.475951 0.475951C0.780698 0.171205 1.19402 0 1.625 0H7.3125C7.52799 0 7.73465 0.0856026 7.88702 0.237976C8.0394 0.390349 8.125 0.597012 8.125 0.8125C8.125 1.02799 8.0394 1.23465 7.88702 1.38702C7.73465 1.5394 7.52799 1.625 7.3125 1.625H1.625V17.875H7.3125C7.52799 17.875 7.73465 17.9606 7.88702 18.113C8.0394 18.2653 8.125 18.472 8.125 18.6875ZM19.2623 9.17516L15.1998 5.11266C15.0474 4.9602 14.8406 4.87455 14.625 4.87455C14.4094 4.87455 14.2026 4.9602 14.0502 5.11266C13.8977 5.26511 13.812 5.47189 13.812 5.6875C13.812 5.90311 13.8977 6.10989 14.0502 6.26234L16.7263 8.9375H7.3125C7.09701 8.9375 6.89035 9.0231 6.73798 9.17548C6.5856 9.32785 6.5 9.53451 6.5 9.75C6.5 9.96549 6.5856 10.1722 6.73798 10.3245C6.89035 10.4769 7.09701 10.5625 7.3125 10.5625H16.7263L14.0502 13.2377C13.8977 13.3901 13.812 13.5969 13.812 13.8125C13.812 14.0281 13.8977 14.2349 14.0502 14.3873C14.2026 14.5398 14.4094 14.6255 14.625 14.6255C14.8406 14.6255 15.0474 14.5398 15.1998 14.3873L19.2623 10.3248C19.3379 10.2494 19.3978 10.1598 19.4387 10.0611C19.4796 9.9625 19.5006 9.85678 19.5006 9.75C19.5006 9.64322 19.4796 9.5375 19.4387 9.43886C19.3978 9.34023 19.3379 9.25062 19.2623 9.17516Z" fill="#111111"/>
                                                </svg>
                                            </div>
                                            <div class="text">Log out</div>
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- /section-menu-left -->
                
                <!-- section-content-right (UPDATED with blogs and testimonials only) -->
                <div class="section-content-right">
                    <!-- header-dashboard -->
                    <div class="header-dashboard">
                        <div class="wrap">
                            <div class="header-left">
                                <a href="/admin-dashboard">
                                    <img style="width: 50px;" id="logo_header_mobile" alt="" src="/images/george/logo.png" data-light="/images/george/logo.png" data-dark="/images/george/logo.png" >
                                </a>
                                <div class="button-show-hide">
                                    <i class="icon-chevron-left"></i>
                                </div>
                            </div>
                            <div class="header-grid">
                                <div class="header-item button-dark-light">
                                    <i class="icon-moon"></i>
                                </div>
                                <div class="header-item button-zoom-maximize">
                                    <div class="">
                                        <i class="icon-maximize"></i>
                                    </div>
                                </div>
                                <div class="popup-wrap user type-header">
                                    <div class="dropdown">
                                        <button class="btn btn-secondary dropdown-toggle" type="button" id="dropdownMenuButton3" data-bs-toggle="dropdown" aria-expanded="false">
                                            <span class="header-user wg-user">
                                                <span class="image">
                                                    <img src="/images/george/logo.png" alt="">
                                                </span>
                                                <span class="flex flex-column">
                                                    <span class="body-text text-main-dark">Georgeforwarders</span>
                                                    <span class="text-tiny">Admin</span>
                                                </span>
                                            </span>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end has-content" aria-labelledby="dropdownMenuButton3" >
                                            <li>
                                                <a href="#" class="user-item">
                                                    <div class="icon">
                                                        <i class="icon-headphones"></i>
                                                    </div>
                                                    <div class="body-title-2">Support</div>
                                                </a>
                                            </li>
                                            <li>
                                                <a href="/admin/logout" class="user-item">
                                                    <div class="icon">
                                                        <i class="icon-log-out"></i>
                                                    </div>
                                                    <div class="body-title-2">Log out</div>
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- /header-dashboard -->
                    
                    <!-- main-content (UPDATED) -->
                    <div class="main-content">
                        <div class="main-content-inner">
                            <div class="main-content-wrap">
                                <!-- Stats Section - Blogs and Testimonials Only -->
                                <div class="content-stats">
                                    <!-- Blog Stats Card -->
                                    <div class="stat-card">
                                        <div class="stat-icon blog">
                                            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M4 4H20V20H4V4Z" stroke="white" stroke-width="2" fill="none"/>
                                                <path d="M8 8H16M8 12H14M8 16H12" stroke="white" stroke-width="2" stroke-linecap="round"/>
                                            </svg>
                                        </div>
                                        <div class="stat-value"><%= blogs ? blogs.length : 0 %></div>
                                        <div class="stat-label">Total Blogs</div>
                                        <div style="margin-top: 12px; font-size: 13px; color: #48bb78;">
                                            <% const newBlogsThisMonth = blogs ? blogs.filter(b => {
                                                const blogDate = new Date(b.createdAt);
                                                const now = new Date();
                                                return blogDate.getMonth() === now.getMonth() && blogDate.getFullYear() === now.getFullYear();
                                            }).length : 0; %>
                                            <%= newBlogsThisMonth > 0 ? '↑ ' + newBlogsThisMonth + ' new this month' : 'No new blogs this month' %>
                                        </div>
                                    </div>
                                    
                                    <!-- Testimonials Stats Card -->
                                    <div class="stat-card">
                                        <div class="stat-icon testimonial">
                                            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M21 11.5C21 16.1944 17.1944 20 12.5 20C11.3925 20 10.3392 19.7662 9.39062 19.3418L3 21L4.6582 14.6094C4.2338 13.6608 4 12.6075 4 11.5C4 6.80558 7.80558 3 12.5 3C17.1944 3 21 6.80558 21 11.5Z" stroke="white" stroke-width="2" fill="none"/>
                                            </svg>
                                        </div>
                                        <div class="stat-value"><%= services ? services.length : 0 %></div>
                                        <div class="stat-label">Total Services</div>
                                        <div style="margin-top: 12px; font-size: 13px; color: #48bb78;">
                                            <%= services ? services.filter(s => s.isPublished).length : 0 %> published
                                        </div>
                                    </div>

                                    <div class="stat-card">
                                        <div class="stat-icon testimonial">
                                            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M21 11.5C21 16.1944 17.1944 20 12.5 20C11.3925 20 10.3392 19.7662 9.39062 19.3418L3 21L4.6582 14.6094C4.2338 13.6608 4 12.6075 4 11.5C4 6.80558 7.80558 3 12.5 3C17.1944 3 21 6.80558 21 11.5Z" stroke="white" stroke-width="2" fill="none"/>
                                            </svg>
                                        </div>
                                        <div class="stat-value"><%= testimonials ? testimonials.length : 0 %></div>
                                        <div class="stat-label">Total Testimonials</div>
                                        <div style="margin-top: 12px; font-size: 13px; color: #fbbf24;">
                                            <% if (testimonials && testimonials.length > 0) { %>
                                                <% const avgRating = testimonials.reduce((sum, t) => sum + (t.rating || 0), 0) / testimonials.length; %>
                                                ⭐ <%= avgRating.toFixed(1) %> average rating
                                            <% } else { %>
                                                No testimonials yet
                                            <% } %>
                                        </div>
                                    </div>
                                </div>

                                <!-- Recent Blogs Section -->
                          

                            

                         

                                <!-- Quick Actions -->
                                <div style="margin-top: 30px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px;">
                                    <a href="/admin/admin-services" class="quick-action">
                                        <div class="quick-action-icon" style="background: linear-gradient(135deg, #38b2ac 0%, #319795 100%);">
                                            <i class="fa fa-briefcase" style="color: white;"></i>
                                        </div>
                                        <div class="quick-action-text">Manage Services (CMS)</div>
                                    </a>
                                    <a href="/admin/admin-blogs" class="quick-action">
                                        <div class="quick-action-icon" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                                            <i class="fa fa-plus" style="color: white;"></i>
                                        </div>
                                        <div class="quick-action-text">Create New Blog Post</div>
                                    </a>
                                    <a href="/admin/admin-testimonials" class="quick-action">
                                        <div class="quick-action-icon" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                                            <i class="fa fa-comment" style="color: white;"></i>
                                        </div>
                                        <div class="quick-action-text">Add New Testimonial</div>
                                    </a>
                                    <a href="/admin/admin-blogs" class="quick-action">
                                        <div class="quick-action-icon" style="background: #48bb78;">
                                            <i class="fa fa-edit" style="color: white;"></i>
                                        </div>
                                        <div class="quick-action-text">Manage Blog Categories</div>
                                    </a>
                                    <a href="/admin/admin-testimonials" class="quick-action">
                                        <div class="quick-action-icon" style="background: #ed8936;">
                                            <i class="fa fa-star" style="color: white;"></i>
                                        </div>
                                        <div class="quick-action-text">Review Pending Testimonials</div>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Javascript -->
    <script src="/admin-js/jquery.min.js"></script>
    <script src="/admin-js/bootstrap.min.js"></script>
    <script src="/admin-js/bootstrap-select.min.js"></script>
    <script src="/admin-js/zoom.js"></script>
    <script src="/admin-js/main.js"></script>
</body>
</html>