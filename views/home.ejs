<section class="service-section-home2-classic">
  <div class="auto-container">
    <div class="row align-items-center">
      
      <!-- LEFT CONTENT -->
      <div class="col-lg-6">
        <div class="sec-title">
          
          <div class="section-sub-title">
            <h1 class="sub-title">
              <img src="images/main-home/sub-title-icon.png" alt="sub-icon">
              Our Services
            </h1>
          </div>

          <div class="section-title">
            <h1 class="title title-anim">George Forwarders</h1>
            <h1 class="title title-anim">Reliable Global Logistics</h1>
          </div>

        </div>
      </div>

      <!-- RIGHT CONTENT -->
      <div class="col-lg-6">
        <div class="section-desc">
          <p class="title-anim">
            At George Forwarders, we go beyond logistics. Our expertise, global reach, 
            and customer-first approach make us a trusted partner for businesses worldwide. 
            We ensure safe handling, timely delivery, and cost-effective solutions for 
            all your freight forwarding needs.
          </p>
        </div>
      </div>

    </div>
  </div>

  <!-- SERVICES SLIDER -->
  <div class="row">
    <div class="swiper service-home2-classic-active">
      <div class="swiper-wrapper">
        <% if (services && services.length) { %>
          <% services.forEach(function(item) { %>
            <% const cardImg = resolveImage(item.cardImageUrl || item.heroImageUrl); %>
            <% const iconImg = item.iconImageUrl ? resolveImage(item.iconImageUrl) : ''; %>
            <% const isAlt = item.cardStyle === 'two'; %>
        <div class="swiper-slide">
          <div class="col-xl-12">
            <div class="single-service-box">
              <div class="service-thumb">
                <figure class="reveal">
                  <img src="<%= cardImg %>" alt="<%= item.title %>">
                </figure>
                <% if (iconImg) { %>
                <div class="service-icon<%= isAlt ? ' two' : '' %>">
                  <img src="<%= iconImg %>" alt="<%= item.title %> icon">
                </div>
                <% } %>
              </div>
              <div class="service-content">
                <h2 class="service-title<%= isAlt ? ' two' : '' %>">
                  <a href="/service/<%= item.slug %>"><%= item.title %></a>
                </h2>
                <p><%= item.shortDescription %></p>
                <a class="service-btn<%= isAlt ? ' two' : '' %>" href="/service/<%= item.slug %>">Explore More
                  <i class="fa-solid fa-arrow-right-long"></i>
                </a>
              </div>
            </div>
          </div>
        </div>
          <% }); %>
        <% } %>
      </div>

      <!-- ARROWS -->
      <div class="loginet-service-arrow-box">
        <button class="slider-prev" aria-label="Previous slide">
          <i class="fa-solid fa-arrow-left-long"></i>
        </button>
        <button class="slider-next" aria-label="Next slide">
          <i class="fa-solid fa-arrow-right-long"></i>
        </button>
      </div>

    </div>
  </div>
</section>
