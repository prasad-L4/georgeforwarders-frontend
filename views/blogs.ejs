	<!-- latest blog section classic -->
	 <div class="latest-blog-section-classic">
		<div class="auto-container">
		<div class="row">
  <% blogs.forEach(blog => { %>
    <div class="col-xl-4 col-lg-6 col-md-6">
      <div class="single-blog-box">
        
        <div class="blog-thumb reveal">
          <img src="/uploads/<%= blog.imageUrl %>" alt="thumb">
        </div>

        <div class="blog-content">
          <div class="blog-meta">
            <a href="/blog/<%= blog.slug %>">
              <%= new Date(blog.createdAt).toDateString() %>
            </a>
          </div>

          <h3 class="blog-title">
            <a href="/blog/<%= blog.slug %>" data-cursor-text="View">
              <%= blog.title %>
            </a>
          </h3>

          <div class="blog-autor">
            <a href="/blog/<%= blog.slug %>">
              By - <span><%= blog.author %></span>
            </a>
          </div>

        </div>

      </div>
    </div>
  <% }) %>
</div>
	
		</div>
			<!-- Pagination -->
	<div class="pagination-wrapper">
  <ul class="pagination">

    <% if (currentPage > 1) { %>
      <li class="page-item">
        <a class="page-link" href="/blogs?page=<%= currentPage - 1 %>">
          <i class="fa-solid fa-arrow-left"></i>
        </a>
      </li>
    <% } %>

    <% for(let i = 1; i <= totalPages; i++) { %>
      <li class="page-item <%= i === currentPage ? 'active' : '' %>">
        <a class="page-link" href="/blogs?page=<%= i %>"><%= i %></a>
      </li>
    <% } %>

    <% if (currentPage < totalPages) { %>
      <li class="page-item">
        <a class="page-link" href="/blogs?page=<%= currentPage + 1 %>">
          <i class="fa-solid fa-arrow-right"></i>
        </a>
      </li>
    <% } %>

  </ul>
</div>
